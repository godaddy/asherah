<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>GoDaddy.Asherah.AppEncryption.Tests</RootNamespace>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Minimum</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CA1816</NoWarn>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.1.0" />
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="MySql.Data" Version="9.6.0" />
    <PackageReference Include="Testcontainers.DynamoDb" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="../AppEncryption/AppEncryption.csproj" />
    <ProjectReference Include="../AppEncryption.PlugIns.Aws/AppEncryption.PlugIns.Aws.csproj" />
  </ItemGroup>
</Project>
